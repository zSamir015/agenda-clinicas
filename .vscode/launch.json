{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (Go)",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}/backend/cmd/api",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Pruebas Go del paquete abierto",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${fileDirname}"
    },
    {
      "name": "Web (Next.js)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/web"
    }
  ]
}
